[*.cs]

# SENTRY0001: O tipo é apenas para fins de avaliação e está sujeito a alterações ou remoção em atualizações futuras. Suprima este diagnóstico para continuar.
dotnet_diagnostic.SENTRY0001.severity = none

# SYSLIB1054: Use 'LibraryImportAttribute' em vez de 'DllImportAttribute' para gerar código de marshalling P/Invoke no tempo de compilação
dotnet_diagnostic.SYSLIB1054.severity = none

# IDE0060: Remover o parâmetro não utilizado
dotnet_diagnostic.IDE0060.severity = none
